{
  "name": "fta-tactics-architect",
  "version": "0.1.0",
  "description": "Deterministic actual-player football scenario simulator",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:logic && npm run test:data && npm run build && node --test tests/rendered-html.test.mjs",
    "test:logic": "node --test tests/tactics-core.test.mjs tests/player-catalog.test.mjs tests/player-name.test.mjs tests/lineup-editor.test.mjs tests/instruction-model.test.mjs tests/path-editing.test.mjs tests/sequence-invalidation.test.mjs tests/simulation-core.test.mjs",
    "test:data": "node --test tests/world-cup-player-data.test.mjs tests/world-cup-player-abilities.test.mjs tests/inferred-player-report.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "verify": "npm run lint && npm run typecheck && npm test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
